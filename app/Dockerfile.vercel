# Container image for Vercel. Runs the same production command as
# Databricks Apps (pnpm run start) so the two deployments stay identical.
# Types in shared/appkit-types are generated by `pnpm run typegen` and
# committed, so the image build needs no Databricks credentials.
FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build:server && pnpm run build:client

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile --prod
COPY --from=build /app/dist ./dist
COPY --from=build /app/client/dist ./client/dist
COPY config ./config
COPY appkit.plugins.json ./
# Vercel routes traffic to port 80 unless PORT is set in the project.
ENV DATABRICKS_APP_PORT=80
EXPOSE 80
CMD ["node", "./dist/server.js"]
